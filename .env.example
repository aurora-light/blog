# AI chat server configuration. Never expose these with a NEXT_PUBLIC_ prefix.
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Query planning uses the same provider and model by default (one bounded call).
# AI_QUERY_MODEL=gpt-4o-mini
# Set false to use local keyword retrieval without model query planning.
AI_QUERY_PLANNING=true

# Follow-up recommendations use the same provider and model by default.
# AI_SUGGESTIONS_MODEL=gpt-4o-mini
# Set false to disable the additional model call after successful answers.
AI_SUGGESTIONS=true

# Optional: use an OpenAI-compatible provider such as DeepSeek.
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# Alternative OpenAI-compatible naming (AIHubmix, etc.).
# LLM_API_KEY=
# LLM_BASE_URL=https://aihubmix.com/v1
# LLM_MODEL_ID=

# Server-only Redis connection used by chat rate limiting.
REDIS_URL=

# 可选：公开 JSON 状态接口；不配置时 health check 返回 unknown
# 支持 Statuspage summary.json 或 {"models":{"模型ID":"available|impacted|unknown"}}
# AI_STATUS_URL=https://your-provider-status.example/api/v2/summary.json
# 可选：仅检查指定 Statuspage component，避免其他服务异常导致误报
# AI_STATUS_COMPONENT_ID=your-api-component-id
