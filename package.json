{
	"name": "lucky-snail-blog",
	"description": "基于 Next.js + tailwindcss + framer motion + contentlayer + github actions + github issues 的个人博客",
	"keywords": [
		"dino",
		"nextjs",
		"tailwindcss",
		"framer motion",
		"contentlayer",
		"github actions",
		"github issues",
		"blog"
	],
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"prepare": "husky install",
		"pre-commit": "lint-staged",
		"predev": "pnpm build:search && pnpm generate-rss && pnpm generate-article-index",
		"dev": "next dev --webpack",
		"prebuild": "pnpm build:search && pnpm generate-rss && pnpm generate-article-index",
		"build": "next build --webpack",
		"start": "next start -p 3003",
		"start:static": "serve -s out -l 3003",
		"lint": "eslint --ext .ts,.js,.jsx,.tsx --fix . ",
		"lint-staged": "lint-staged",
		"sync-post": "node ./scripts/sync-post.js",
		"upload:image": "node ./scripts/upload-blog-image.mjs",
		"generate-rss": "node ./scripts/generate-rss.js",
		"generate-article-index": "node ./scripts/build-article-index.mjs",
		"test:rag": "pnpm build:search && node --test tests/rag.test.mjs",
		"serve": "serve -s out",
		"build:search": "pnpm --filter @leslie/search-core build",
		"test:search": "pnpm --filter @leslie/search-core test",
		"test:home": "node --test tests/home.test.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.104",
		"@ai-sdk/react": "^4.0.160",
		"@emotion/is-prop-valid": "^1.4.0",
		"@radix-ui/react-aspect-ratio": "^1.2.0",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-hover-card": "^1.2.1",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-navigation-menu": "^1.4.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-toast": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@radix-ui/react-use-controllable-state": "^1.3.0",
		"@splinetool/react-spline": "^4.1.0",
		"@streamdown/cjk": "^1.0.4",
		"@streamdown/code": "^2.0.0",
		"@streamdown/math": "^1.0.3",
		"@streamdown/mermaid": "^1.0.3",
		"@vercel/blob": "^2.8.2",
		"ai": "^7.0.156",
		"class-variance-authority": "^0.7.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"contentlayer2": "^0.5.8",
		"dayjs": "^1.11.23",
		"dotenv": "^18.0.9",
		"fs-extra": "^11.4.1",
		"github-api": "^3.4.0",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.63.0",
		"motion": "^14.7.1",
		"next": "16.4.3",
		"next-contentlayer2": "^0.5.8",
		"next-themes": "^0.4.6",
		"next-view-transitions": "^0.3.5",
		"node-cron": "^4.6.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-medium-image-zoom": "^5.4.9",
		"react-pdf": "^11.0.0",
		"react-wrap-balancer": "^1.1.1",
		"reading-time": "^1.5.0",
		"redis": "^6.3.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-prism-plus": "^2.0.2",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "4.0.1",
		"rss": "^1.2.2",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"sonner": "^2.0.8",
		"streamdown": "^2.7.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"tocbot": "^4.36.8",
		"zod": "^4.6.7",
		"@leslie/search-core": "workspace:*"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/rss": "^0.0.32",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^9.39.4",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globby": "^16.2.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"pdfjs-dist": "6.3.289",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"remark-rehype": "^11.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"unified": "^11.0.5"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
